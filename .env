# ── Active environment: local | development | production ──────────────────────
NODE_ENV=local

# ── Local (emulator / simulator) ──────────────────────────────────────────────
LOCAL_API=http://192.168.100.27:3004/api/v1
LOCAL_SOCKET=ws://http://192.168.100.27:3004/api/v1

# ── Development / Staging (remote server) ─────────────────────────────────────
DEV_API=https://naseebagri.com/api/v1
DEV_SOCKET=ws://naseebagri.com/api/v1

# ── Production ─────────────────────────────────────────────────────────────────
PROD_API=https://api.naseebagro.com/api/v1
PROD_SOCKET=wss://api.naseebagro.com

# ── Shared ─────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
APP_TIMEOUT=30000
