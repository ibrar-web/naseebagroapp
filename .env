# ── Active environment: local | development | production ──────────────────────
NODE_ENV=local

# ── Local (emulator / simulator) ──────────────────────────────────────────────
LOCAL_API=http://192.168.100.26:3004/api/v1
LOCAL_SOCKET=http://192.168.100.26:3004

# ── Development / Staging (remote server) ─────────────────────────────────────
DEV_API=https://naseebagri.com/api/v1
DEV_SOCKET=https://naseebagri.com

# ── Production ─────────────────────────────────────────────────────────────────
PROD_API=https://api.naseebagro.com/api/v1
PROD_SOCKET=wss://api.naseebagro.com

# ── Shared ─────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
APP_TIMEOUT=30000

# ── Android Release Signing ───────────────────────────────────────────────────
# Keystore file: android/app/naseeb_upload.keystore
# Properties file: android/key.properties

