# Copy to audit/.env.audit (git-ignored) and fill in. CI reads the same names from secrets.

# local | development | production   (or set AUDIT_BASE_URL to any API base)
AUDIT_ENV=development
# AUDIT_BASE_URL=https://api.naseebagri.com/api/v1

# Test accounts, comma separated email:password. The audit tries each one until it finds
# records, so list a few accounts with different data (buyer-heavy, seller-heavy, with disputes...).
AUDIT_USERS=user1@naseeb.test:CHANGE_ME,user2@naseeb.test:CHANGE_ME

# Thresholds (ms)
AUDIT_WARN_MS=1000
AUDIT_FAIL_MS=3000
AUDIT_TIMEOUT_MS=30000
AUDIT_LOAD_CONCURRENCY=25

# Report branding (optional)
# AUDIT_ORG=Naseeb Agri
# AUDIT_PRODUCT=Naseeb Agri mobile app: backend API
# AUDIT_PREPARED_BY=QA Team          (defaults to your git user.name)
# AUDIT_GATE_PASS_RATE=95            (exit criterion: minimum pass rate %)
# CHROME_PATH=/path/to/chrome        (only if Chrome/Edge is not in the usual place)
# AUDIT_KEEP_REPORTS=1            (how many runs to keep in audit/reports; older ones are deleted)

# Accounts that must NOT be able to log in (inactive, KYC-rejected). Used by the security check
# "Inactive and KYC-rejected accounts cannot log in"; skipped when empty.
AUDIT_BLOCKED_USERS=user7@naseeb.test:CHANGE_ME,user9@naseeb.test:CHANGE_ME

# Admin account for admin API tests and --flows (needs the "admin" role; superadmin cannot approve posts).
AUDIT_ADMIN=admin@naseeb.test:CHANGE_ME
